{
  "name": "snak-site",
  "private": true,
  "license": "MIT",
  "author": "SnakOleg",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "SINGLE=1 vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions && tsc --noEmit -p shared && tsc --noEmit -p tests && tsc --noEmit -p realtime",
    "sync": "node scripts/sync-github.mjs",
    "build:demo": "VITE_DEMO=1 vite build",
    "dev:api": "npm run build && npm run db:migrate:local && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply snak-db --local",
    "db:migrate": "wrangler d1 migrations apply snak-db --remote",
    "live:deploy": "wrangler deploy -c realtime/wrangler.toml",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "motion": "^14.0.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.148.0"
  }
}
